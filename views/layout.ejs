<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title || "Cold Cases" %></title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="Cold Cases home">
        <span class="mark">cc</span>
        <span>Cold Cases</span>
      </a>
      <nav>
        <% if (user) { %>
          <a class="button" href="/submit">Submit</a>
          <form action="/logout" method="post">
            <button type="submit" class="button ghost">@<%= user.login %> sign out</button>
          </form>
        <% } else { %>
          <a class="button" href="/login">GitHub login</a>
        <% } %>
      </nav>
    </header>
    <main>
      <%- body %>
    </main>
  </body>
</html>
