<div class="activity-rail">
  <h3><%= title %></h3>
  <% if (rows.length === 0) { %>
    <div class="rail-empty"><span></span><span></span><span></span></div>
  <% } else { %>
    <% const railMax = Math.max(1, ...rows.slice(0, 5).map((row) => row.count)); %>
    <% rows.slice(0, 5).forEach((row) => { %>
      <% const value = row[valueKey]; %>
      <% const pct = Math.max(10, Math.round((row.count / railMax) * 100)); %>
      <% const step = Math.min(100, Math.max(10, Math.round(pct / 10) * 10)); %>
      <div class="rail-row">
        <div class="rail-label">
          <span><%= value %></span>
          <strong><%= row.count %></strong>
        </div>
        <div class="rail-track" aria-hidden="true">
          <span class="rail-fill w-<%= step %>"></span>
        </div>
      </div>
    <% }) %>
  <% } %>
</div>
