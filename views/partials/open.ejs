<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= title ? `${title} · Cold Cases` : "Cold Cases" %></title>
    <meta name="description" content="A metadata-only ledger for research cold cases: failed, abandoned, and stale-looped attempts, with revive conditions and artifact references.">
    <meta property="og:title" content="<%= title || "Cold Cases" %>">
    <meta property="og:description" content="Pull prior failures, metrics, and revive conditions. Metadata only — this instance does not host research payloads.">
    <meta property="og:type" content="website">
    <meta name="theme-color" content="#ff7a1a">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="topbar">
      <a class="brand" href="/">
        <span class="mark" aria-hidden="true">cc</span>
        <span>Cold Cases</span>
      </a>
      <nav aria-label="Primary">
        <a class="button ghost" href="/browse">Browse</a>
        <% if (user) { %>
          <a class="button primary" href="/submit">Submit</a>
          <form class="nav-auth" action="/logout" method="post">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="button ghost">@<%= user.login %> · sign out</button>
          </form>
        <% } else if (oauthConfigured) { %>
          <a class="button ghost" href="/login">GitHub login</a>
        <% } else { %>
          <span class="login-note">GitHub login is not configured</span>
        <% } %>
      </nav>
    </header>
    <main id="content">
