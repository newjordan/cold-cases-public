<%- include("partials/open", { title: cert.projectTarget }) %>
<article class="receipt">
  <header class="receipt-head">
    <div>
      <p class="eyebrow">Cold case receipt</p>
      <h1><%= cert.projectTarget %></h1>
      <p class="meta-line">Version <%= cert.currentVersion %> · submitted by @<%= cert.submitterLogin %> · <time datetime="<%= cert.createdAt %>"><%= new Date(cert.createdAt).toLocaleString() %></time></p>
      <p class="meta-line">
        <span class="badge <%= cert.publishState %>"><%= cert.publishState %></span>
        <% if (cert.publicCaseId) { %>
          · <a href="/cases/<%= cert.publicCaseId %>.json">Public relay JSON</a>
        <% } %>
      </p>
      <p class="meta-line">
        <a href="/api/cases/<%= cert.id %>">API JSON</a>
        ·
        <a href="/api/cases/<%= cert.id %>/canonical">Canonical JSON</a>
      </p>
    </div>
    <% if (canAmend) { %>
      <a class="button" href="/cases/<%= cert.id %>/amend">Amend</a>
    <% } %>
  </header>

  <% if (cert.hidden) { %>
    <div class="notice">Hidden by admin. Reason: <%= cert.hiddenReason || "not specified" %></div>
  <% } %>
  <% if (publishErrors && publishErrors.length) { %>
    <div class="errors" role="alert">
      <% publishErrors.forEach((error) => { %><p><%= error %></p><% }) %>
    </div>
  <% } %>

  <dl class="receipt-grid">
    <div><dt>Failure class</dt><dd><%= cert.failureClass %></dd></div>
    <div><dt>Client record ID</dt><dd><%= cert.clientRecordId || "not supplied" %></dd></div>
    <div><dt>Project namespace</dt><dd><%= cert.projectNamespace || "not supplied" %></dd></div>
    <div><dt>Run ID</dt><dd><%= cert.runId || "not supplied" %></dd></div>
    <div><dt>Tags</dt><dd><%= cert.tags.length ? cert.tags.join(", ") : "not supplied" %></dd></div>
    <div><dt>Artifact kind</dt><dd><%= cert.artifactKind || "not supplied" %></dd></div>
    <div><dt>Artifact label</dt><dd><%= cert.artifactLabel || "not supplied" %></dd></div>
    <div><dt>Artifact size</dt><dd><%= cert.artifactSizeBytes === null || cert.artifactSizeBytes === undefined ? "not supplied" : cert.artifactSizeBytes + " bytes" %></dd></div>
    <div><dt>Artifact reference</dt><dd><code class="wrap"><%= cert.artifactUri || cert.hostedZipUrl || "not supplied" %></code></dd></div>
    <div><dt>Command</dt><dd><code><%= cert.command %></code></dd></div>
    <div><dt>Metric</dt><dd><%= cert.metric %></dd></div>
    <div><dt>Failure reason</dt><dd><%= cert.failureReason %></dd></div>
    <div><dt>Revive condition</dt><dd><%= cert.reviveCondition %></dd></div>
    <div><dt>Provenance</dt><dd><%= cert.provenance %></dd></div>
    <div><dt>Research repo</dt><dd><a href="<%= cert.repoUrl %>" rel="nofollow ugc noopener noreferrer"><%= cert.repoUrl %></a></dd></div>
    <div><dt>Hosted zip</dt><dd><% if (cert.hostedZipUrl) { %><a href="<%= cert.hostedZipUrl %>" rel="nofollow ugc noopener noreferrer"><%= cert.hostedZipUrl %></a><% } else { %>not supplied<% } %></dd></div>
    <div class="wide"><dt>Submitter-provided zip SHA256</dt><dd><code class="wrap"><%= cert.zipSha256 %></code><span class="field-hint">Not verified by this instance.</span></dd></div>
  </dl>

  <section>
    <div class="section-head">
      <h2>Canonical JSON</h2>
      <button class="button ghost" type="button" data-copy-for="canonicalJson">Copy JSON</button>
    </div>
    <pre class="json" id="canonicalJson"><code><%= cert.canonicalJson %></code></pre>
  </section>

  <section>
    <h2>Event History</h2>
    <ol class="events">
      <% cert.events.forEach((event) => { %>
        <li>
          <strong><%= event.eventType %></strong>
          <% if (event.version) { %>v<%= event.version %><% } %>
          by @<%= event.actorLogin %>
          on <time datetime="<%= event.createdAt %>"><%= new Date(event.createdAt).toLocaleString() %></time>
          <% if (event.reason) { %><span> · <%= event.reason %></span><% } %>
        </li>
      <% }) %>
    </ol>
  </section>

  <% if (isAdmin) { %>
    <form class="hide-form publish-form" method="post" action="/cases/<%= cert.id %>/publish">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>
        Publish state
        <select name="state">
          <% ["private", "public_pending", "public_relay", "public_blocked"].forEach((state) => { %>
            <option value="<%= state %>" <%= cert.publishState === state ? "selected" : "" %>><%= state %></option>
          <% }) %>
        </select>
      </label>
      <label>
        Block reason
        <input name="reason" value="<%= cert.publicBlockReason || "" %>" placeholder="required context when blocking">
      </label>
      <button type="submit" class="button">Update publish state</button>
    </form>
  <% } %>

  <% if (isAdmin && !cert.hidden) { %>
    <form class="hide-form" method="post" action="/cases/<%= cert.id %>/hide">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label>
        Hide reason
        <input name="reason" placeholder="spam or abuse reason">
      </label>
      <button type="submit" class="button danger">Hide</button>
    </form>
  <% } %>
</article>
<%- include("partials/close") %>
