# Each operator self-hosts their own instance. These are YOUR instance's
# settings and database; nothing here is shared between instances.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:3000/auth/github/callback
SESSION_SECRET=change-me
DATABASE_PATH=./data/cold-cases.sqlite
PUBLIC_RELAY_DIR=./public-relay
# GitHub logins that may manage peers and view hidden cases on this instance.
ADMIN_GITHUB_LOGINS=
AGENT_SUBMIT_TOKENS=atlas:change-me-agent-token
PORT=3000
# Set to 1 when a reverse proxy terminates TLS in front of this process.
TRUST_PROXY=0
# Optional per-IP request caps. Defaults are 120 writes and 600 reads per minute.
# WRITE_RATE_LIMIT_MAX=120
# READ_RATE_LIMIT_MAX=600

# Read-only peer pull is configured at runtime via the admin API
# (POST /api/peers), not via env. See docs/SELF_HOSTING.md.
